# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — single file for all modes (dev + prod)
# Edit values here directly. Vite reads this on every `npm run dev` / `build`.
# ─────────────────────────────────────────────────────────────────────────────

# Backend target
# ──────────────
# VITE_USE_LOCAL=true  → hits VITE_LOCAL_API_URL (local backend)
# VITE_USE_LOCAL=false → hits VITE_PROD_API_URL  (production backend)
VITE_USE_LOCAL=true
VITE_LOCAL_API_URL=http://187.127.139.10:8080
VITE_PROD_API_URL=https://api.sclinnexus.com

# Demo / mock mode
# ────────────────
# true  → use mock users, bypass real auth
# false → real backend auth
VITE_ENABLE_DEMO=false

# Verbose API logging in the browser console
# ──────────────────────────────────────────
# true  → log every request/response (useful while developing)
# false → silent (use this in production)
VITE_API_DEBUG=true
